  "implementation_guide": {
    "step1": "使用固定阈值法：根据国家排放标准设定硬性阈值",
    "step2": "使用IQR法：用上述阈值检测统计异常",
    "step3": "使用Hampel Filter：窗口大小24-48小时，检测时序突变",
    "step4": "使用梯度检测：检测数据突变异常",
    "step5": "使用PCA+T2：检测多指标同时异常的情况",
    "step6": "综合判定：多个方法都判定为异常才报警"
  },
  "recommended_config": {
    "inlet": {
      "single_variable": ["iqr_outlier", "hampel_filter", "gradient_detection"],
      "multivariate": ["pca_hotelling_t2"]
