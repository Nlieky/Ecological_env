{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SubagentOutput",
  "type": "object",
  "properties": {
    "task_id": {
      "type": "string",
      "description": "任务唯一标识符"
    },
    "status": {
      "type": "string",
      "enum": ["success", "failure"],
      "description": "执行状态"
    },
    "result": {
      "type": "object",
      "description": "执行结果"
    },
    "errors": {
      "type": "array",
      "items": {"type": "string"},
      "description": "错误信息列表"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "完成时间戳"
    }
  },
  "required": ["task_id", "status"]
}
