# ====================================================================
# 废水虚假排放监测系统 - 环境变量配置（复制为 .env 后填写真实值）
# 部署前必填：LLM_* 与 INFLUXDB_TOKEN；其余有默认值，按需调整。
# ====================================================================

# ==================== LLM 配置（核心）====================
# OpenAI 兼容接口。每台机器填【本机要用的】LLM 地址/密钥/模型名，互不干扰。
# .env 不进仓库，所以每台机器（笔记本/台式/服务器）都要自己 cp .env.example .env 后填写。
# 下面三行默认注释：不取消则回落到 agent_params.py 的代码默认值(llm_base_url/llm_model)。
# 用自己的 LLM 时取消注释并填真实值——占位符地址格式非法,原样保留会导致 agent 服务启动即失败。
#LLM_BASE_URL=http://127.0.0.1:30000/v1
#LLM_API_KEY=your-api-key-here
#LLM_MODEL=your-model-name
# 示例参考（按你的实际 LLM 改）：
#   本地部署模型:        LLM_BASE_URL=http://127.0.0.1:30000/v1  LLM_MODEL=your-model-name
#   美团 LongCat-2.0:   LLM_BASE_URL=https://api.longcat.chat/openai/v1  LLM_MODEL=LongCat-2.0

# ==================== FastAPI 后端（端口 8000）====================
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000
CORS_ORIGINS=*
LOG_LEVEL=INFO

# ==================== Agent 服务（端口 8642，主智能体 + 子智能体编排）====================
# 后端通过 AGENT_SERVICE_URL 转发 /api/query → Agent 服务。
# 本地直跑用 localhost；Docker 部署时 docker-compose 会覆盖成 http://agent:8642(容器服务名)。
AGENT_SERVICE_URL=http://localhost:8642
AGENT_HOST=0.0.0.0
AGENT_PORT=8642
# 超时层级（外层压内层，部署时建议 AGENT_TIMEOUT >= HERMES_TOTAL_TIMEOUT）：
#   AGENT_TIMEOUT       后端 → Agent 服务的 HTTP 请求超时
#   HERMES_TOTAL_TIMEOUT  Agent 服务内主智能体 run_conversation 总超时
#   SUBAGENT_TIMEOUT      单个子智能体 subprocess 超时（异常检测偶 >300s）
AGENT_TIMEOUT=300
HERMES_TOTAL_TIMEOUT=300
SUBAGENT_TIMEOUT=600

# ==================== InfluxDB 2.7（时序数据源，必填 TOKEN）====================
# 监测数据后端：influxdb（默认，读本地 InfluxDB）或 csv（回退到 shared/data/*.csv）
MONITORING_DATA_SOURCE=influxdb
INFLUXDB_URL=http://localhost:8086
# all-access token（InfluxDB Web UI → Load Data → API Tokens 获取）
INFLUXDB_TOKEN=your-influxdb-all-access-token-here
INFLUXDB_ORG=ecological_env
INFLUXDB_BUCKET=monitoring-real
INFLUXDB_REAL_BUCKET=monitoring-real
INFLUXDB_SIMULATION_BUCKET=monitoring-simulation
# 当前业务数据来自监管平台下载的历史报表；接入持续 API 后将模式改为 live。
BUSINESS_DATA_MODE=historical
DATA_TIMEZONE=Asia/Shanghai
DATA_STALE_AFTER_HOURS=6

# ==================== 事件助手写入（默认关闭）====================
# 助手事件操作需要候选、diff 和人工确认；此开关仅用于后端写入功能门控。
ASSISTANT_EVENT_WRITES_ENABLED=false

# ==================== Prometheus / Grafana（系统监控，当前搁置）====================
# 仅供未来系统运行指标监测，不用于废水业务数据；现阶段保持关闭。
PROMETHEUS_PORT=9090
PROMETHEUS_ENABLED=0
GRAFANA_URL=http://localhost:3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-before-enabling-grafana

# ==================== 告警阈值（违规判定 / 规则推理用）====================
PH_MIN=6.0
PH_MAX=9.0
COD_MAX=100
TN_MAX=15
AN_MAX=5
TP_MAX=1.0
