# ==================== Flask 配置 ====================
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=false

# ==================== Prometheus 配置 ====================
PROMETHEUS_PORT=9090
ENABLE_PROMETHEUS=true

# ==================== Hermes API Server 配置 ====================
# Hermes API Server 端口（默认8642）
API_SERVER_PORT=8642
# API Server 密钥
API_SERVER_KEY=sk-hermes-api-key
# CORS 配置（允许跨域访问）
API_SERVER_CORS_ORIGINS=*

# ==================== FastAPI 配置 ====================
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000
FASTAPI_DEBUG=false

# ==================== Hermes API Server 后端配置 ====================
HERMES_API_URL=http://localhost:8642
HERMES_API_KEY=sk-hermes-api-key

# ==================== LLM API 配置 ====================
# 方式1：使用本地部署的自定义大模型服务器（推荐）
LLM_BASE_URL=http://172.16.12.41:30000/v1
LLM_API_KEY=your-api-key-here
LLM_MODEL=your-model-name-here

# 方式2：使用自定义API端点（Hermes框架兼容）
# ANTHROPIC_AUTH_TOKEN=sk-ant-your-actual-auth-token-here
# ANTHROPIC_BASE_URL=https://your-api-gateway.com/v1

# 方式3：使用默认端点（向后兼容）
# 如果未设置ANTHROPIC_AUTH_TOKEN，将使用ANTHROPIC_API_KEY
# ANTHROPIC_API_KEY=sk-ant-your-actual-api-key-here

# 模型配置
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# ==================== 飞书集成配置 ====================
# 飞书机器人Webhook URL
FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/your_webhook_url_here
# 是否启用飞书通知
FEISHU_ENABLED=true
# 飞书应用凭证（可选，用于高级功能）
FEISHU_APP_ID=your_app_id_here
FEISHU_APP_SECRET=your_app_secret_here

# ==================== 数据流配置 ====================
# 数据目录
DATA_DIR=../data
# 进水数据文件
INFLUENT_FILE=pollution_water_in.csv
# 出水数据文件
EFFLUENT_FILE=pollution_water_out.csv
# 出水滞后时间（小时）
LAG_HOURS=2
# 模拟加速因子（1=实时，60=1分钟模拟1小时）
SPEED_FACTOR=60

# ==================== 数据库配置（可选） ====================
# DATABASE_URL=postgresql://user:password@localhost:5432/wastewater
# DATABASE_URL=sqlite:///./wastewater.db

# ==================== 日志配置 ====================
LOG_LEVEL=INFO
LOG_FILE=middleware.log

# ==================== 告警阈值配置 ====================
# pH值阈值
PH_MIN=6.0
PH_MAX=9.0
# COD阈值（mg/L）
COD_MAX=100
# 总氮阈值（mg/L）
TN_MAX=15
# 氨氮阈值（mg/L）
AN_MAX=5
# 总磷阈值（mg/L）
TP_MAX=1.0

# ==================== Grafana 配置 ====================
GRAFANA_URL=http://localhost:3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
GRAFANA_API_KEY=your_grafana_api_key_here

# ==================== LLM 实时分析功能开关 ====================
# 启用 LLM 实时分析功能（默认关闭）
# 设置为 true 时，系统会定期对缓冲数据执行两层 LLM 分析
ENABLE_LLM_REALTIME_ANALYSIS=false

# ==================== InfluxDB 配置（工业时序数据 v2.7）====================
# 监测数据后端: influxdb(默认,读本地 InfluxDB 的 monitoring-data bucket)
#               或 csv(回退到 shared/data/*.csv 历史数据)
MONITORING_DATA_SOURCE=influxdb
INFLUXDB_URL=http://localhost:8086
# all-access token(在 InfluxDB Web UI → Load Data → API Tokens 获取)
INFLUXDB_TOKEN=your-influxdb-all-access-token-here
INFLUXDB_ORG=ecological_env
INFLUXDB_BUCKET=monitoring-data
