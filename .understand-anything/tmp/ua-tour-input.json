    {"id": "layer:shared-core", "name": "共享核心层", "description": "跨模块共享的机器学习模型、统计检测算子、配置管理和输出处理"},
    {"id": "layer:middleware", "name": "中间件层", "description": "Web接口、查询接口、应用编排器、飞书集成、Prometheus监控指标和前端静态资源"},
    {"id": "layer:knowledge-data", "name": "知识与数据层", "description": "领域知识库（专家规则、违规模式、结构化法规）、历史数据文件、数据流处理"},
    {"id": "layer:interfaces", "name": "接口与规范层", "description": "系统接口定义、数据模式规范、状态管理协议、子代理通信协议"},
