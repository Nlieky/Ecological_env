      "tags": ["别名", "处理函数"],
      "complexity": "simple"
    },
    {
      "id": "function:subagents/anomaly-detection-agent/skills/anomaly-detection-core/scripts/operator_adapter.py:select_operators_by_intent",
      "type": "function",
      "name": "select_operators_by_intent",
      "filePath": "subagents/anomaly-detection-agent/skills/anomaly-detection-core/scripts/operator_adapter.py",
      "lineRange": [181, 227],
      "summary": "基于自然语言意图选择合适的异常检测算子。通过IntentOperatorMapper将用户意图（异常检测、相关性分析、趋势分析）映射到具体算子列表，支持数据特征适配。",
      "tags": ["意图识别", "算子选择", "自然语言"],
      "complexity": "moderate"
    },
    {
