      "id": "file:subagents/anomaly-detection-agent/skills/anomaly-detection-core/scripts/operator_adapter.py",
      "type": "file",
      "name": "operator_adapter.py",
      "filePath": "subagents/anomaly-detection-agent/skills/anomaly-detection-core/scripts/operator_adapter.py",
      "summary": "算子调用与适配模块，集成统计类、机器学习类、深度学习类三类异常检测算子，支持基于意图的动态算子选择。提供20+种异常检测算法，包括zscore、IQR、孤立森林、VAE等，并支持相关性和趋势分析算子。",
      "tags": ["异常检测", "算子适配器", "机器学习", "统计方法", "深度学习", "特征分析"],
      "complexity": "complex",
      "languageNotes": "使用策略模式注册算子，支持可选依赖（sklearn、PyOD、PyTorch）的优雅降级。通过鲁棒参数估计器增强统计方法的抗干扰能力。"
    },
    {
      "id": "class:subagents/anomaly-detection-agent/skills/anomaly-detection-core/scripts/operator_adapter.py:OperatorAdapter",
      "type": "class",
      "name": "OperatorAdapter",
      "filePath": "subagents/anomaly-detection-agent/skills/anomaly-detection-core/scripts/operator_adapter.py",
      "lineRange": [76, 1302],
      "summary": "算子适配器核心类，管理20+种异常检测算子的注册、选择和执行。支持统计类、机器学习类、PyOD、深度学习、特征分析五大类算子，并集成意图映射器实现基于自然语言意图的动态算子选择。",
      "tags": ["算子管理", "异常检测", "意图映射", "适配器模式"],
      "complexity": "complex"
    },
    {
