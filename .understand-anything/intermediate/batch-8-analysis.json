      "id": "file:middleware/app_orchestrator.py",
      "type": "file",
      "name": "app_orchestrator.py",
      "filePath": "middleware/app_orchestrator.py",
      "summary": "基于Orchestrator-Core架构的Flask中间件，提供废水监测双流处理。实时流更新Prometheus指标，分析流（已禁用）执行两层LLM分析。集成任务接收、子智能体协调和结果解释模块。",
      "tags": ["中间件", "api-handler", "orchestrator-core", "监控", "入口点"],
      "complexity": "complex",
      "languageNotes": "使用Flask构建REST API，集成Prometheus指标采集。LLM分析功能已暂时禁用但保留了完整代码框架。"
    },
    {
      "id": "file:middleware/query_interface.py",
      "type": "file",
      "name": "query_interface.py",
      "filePath": "middleware/query_interface.py",
      "summary": "自然语言查询接口，使用LLM驱动架构解析用户查询意图、调度子智能体分析并整合结果生成报告。支持历史数据获取、异常检测和相关性分析。",
      "tags": ["查询接口", "api-handler", "llm驱动", "数据分析", "入口点"],
      "complexity": "complex",
      "languageNotes": "完整的LLM驱动流程：意图解析→数据获取→子智能体协调→结果整合。自定义JSON编码器处理numpy类型。"
    },
