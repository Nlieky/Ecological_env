      "id": "file:middleware/app_orchestrator.py",
      "type": "file",
      "name": "app_orchestrator.py",
      "filePath": "middleware/app_orchestrator.py",
      "summary": "应用编排中间件，提供Flask API端点用于接收双流数据（进水和出水）、触发LLM分析、获取分析结果和管理分析器状态。集成Prometheus指标监控和健康检查端点。",
      "tags": ["middleware", "api-handler", "monitoring", "health-check", "orchestration"],
      "complexity": "complex"
    },
    {
      "id": "function:middleware/app_orchestrator.py:receive_dual_stream",
      "type": "function",
      "name": "receive_dual_stream",
      "filePath": "middleware/app_orchestrator.py",
      "lineRange": [492, 587],
      "summary": "接收并处理双流数据（进水和出水），更新Prometheus指标，通过分析器管道处理数据，并返回带有异常检测结果的响应。",
      "tags": ["api-handler", "data-processing", "monitoring", "pipeline"],
      "complexity": "complex"
    },
    {
      "id": "function:middleware/app_orchestrator.py:update_prometheus_metrics",
