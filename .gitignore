.env
.hermes/cache/
ecological_env/

# Session state directories
workspace/state/
subagents/*/state/
*.state/

# Brainstorm visual companion scratch (mockups); committed specs live in docs/superpowers/specs/
.superpowers/

# Hermes 智能体自动生成的运行时目录
workspace/cron/
workspace/logs/
workspace/memories/
workspace/memory/
workspace/sessions/
workspace/cron/output/
workspace/logs/curator/
subagents/*/sessions/
subagents/*/logs/
subagents/*/auth.lock
subagents/*/.usage.json.lock

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd
.Python

# Test artifacts
.pytest_cache/
.coverage
htmlcov/

# Runtime SQLite databases (created by init_db.py, not version-controlled)
*.db
*.db-journal
*.sqlite3

# Agent runtime artifacts (project-root level)
/sessions/
*.log
anomaly_result.csv

# Editor/dev backups
*.bak
# 身份文件在线编辑的原子写临时文件(save_file: tmp+rename)
*.md.tmp
# Prometheus 二进制(vendored) + TSDB 数据，不入库
prometheus/prometheus.exe
prometheus/prom_data/
grafana/prom_data/

# vendored hermes 框架——已纳入仓库(部署需要:台式机 clone 后能直接 docker build,
# 不用再跑 vendor_hermes.py)。pycache 等仍由上面的通用规则忽略。
# shared/framework/hermes-agent/

# Hermes 子智能体运行时产物（脚本/会话写出，可随时重生成，不入库）
subagents/*/skills/.usage.json
subagents/*/skills/.usage.json.lock
subagents/*/.skills_prompt_snapshot.json
subagents/*/cache/
subagents/*/*_result.json
subagents/*/smoke_q*.json

# 临时测试/调试文件(下划线开头,调试时随手建的)
_*.json
_*.png
_*.txt
_*.csv
__*.mjs
# Hermes 根级运行时残留
auth.lock
.skills_prompt_snapshot.json

# Hermes 平台生成的目录(本项目不用)
subagents/*/audio_cache/
subagents/*/image_cache/
subagents/*/cron/
subagents/*/hooks/
subagents/*/pairing/
subagents/*/sandboxes/

# shared 运行时输出/缓存(不提交)
shared/outputs/*
!shared/outputs/.gitkeep
shared/cache/

# Hermes 框架记忆(环境相关,各自积累,不入库)
memories/

# 运行时日志(不入库)
logs/*
!logs/.gitkeep

# Hermes 平台缓存(本项目不用图像/音频生成)
image_cache/
audio_cache/

# 根级 Hermes 平台目录 + 覆盖率报告(运行时/测试产物)
/cron/
/hooks/
/cache/
/audio_cache/
/image_cache/
/htmlcov/

# understand-anything 技能生成的知识图谱(分析产物,可再生)
.understand-anything/

# 真实监测报表(内部数据,不入库,各机自己上传到 shared/data/real-time/)
shared/data/real-time/*.xls
config.yaml
models_dev_cache.json
*/models_dev_cache.json
.workbuddy/
skills/.hub/
*.tar.gz
